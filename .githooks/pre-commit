#!/bin/sh
# Hook de pre-commit (F-007, regla 4b): los gates Y la suite, con la regresión adentro.
# Se activa con: git config core.hooksPath .githooks   (ver COMO-INSTALAR-EL-GATE.md)
cd "$(git rev-parse --show-toplevel)" || exit 1
npm run --silent gate || exit 1
npm test --silent || { echo "✗ npm test en rojo — COMMIT RECHAZADO"; exit 1; }
